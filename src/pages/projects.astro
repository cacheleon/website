---
import Base from "../layouts/Base.astro";

const git = "https://git.cacheleon.dev";

const projects = [
  {
    name: "ponko",
    lang: "rust",
    status: "active",
    when: "2026",
    desc: "A code-first 2D/3D game engine. Archetype ECS with parallel queries, a custom wgpu renderer, headless fixed-tick simulation, C and C++ bindings, and an MCP server so AI tools can launch, step, inspect and screenshot a running game.",
    highlights: [
      "Games are plain Rust code, no big visual editor needed",
      "Runs simulations without a window or GPU",
      "Runtime inspector, logs, traces and profiling built in",
    ],
    links: [
      { label: "ponko.dev", href: "https://ponko.dev/" },
      { label: "github", href: "https://github.com/ponkoengine/ponko" },
    ],
  },
  {
    name: "order-book",
    lang: "c++",
    status: "done",
    when: "2025–2026",
    desc: "A low-latency order book with price-time priority matching: limit, IOC and FOK orders, cancel and modify. About 42 ns median latency on a 100k-order book.",
    highlights: [
      "Cache-aware price levels, a vector-backed order pool and intrusive queues, so the hot path barely allocates",
      "Correctness tests with GoogleTest and microbenchmarks",
    ],
    metrics: [
      { value: "42 ns", label: "p50" },
      { value: "250 ns", label: "p99" },
      { value: "334 ns", label: "p99.9" },
      { value: "100k", label: "resting orders" },
    ],
    links: [{ label: "git", href: `${git}/order-book.git/` }],
  },
  {
    name: "honeycomb",
    lang: "rust",
    status: "wip",
    when: "2026",
    desc: "A UCI-compatible chess engine written from scratch.",
    highlights: [
      "Bitboards, legal move generation and reversible make/unmake",
      "Iterative deepening alpha-beta, quiescence search, move ordering, Zobrist hashing and a transposition table",
      "Formatting, linting, tests and release builds in CI",
    ],
    metrics: [
      {
        value: "119,060,324",
        label: "perft positions at depth 6, all correct",
      },
    ],
    links: [{ label: "git", href: `${git}/honeycomb.git/` }],
  },
  {
    name: "bocaml",
    lang: "ocaml",
    status: "wip",
    when: "2026",
    desc: "A compiler for B, Ken Thompson's 1972 predecessor to C. It lexes, parses and emits LLVM IR, which llc turns into a native binary. Work in progress.",
    highlights: [
      "Hand-written lexer and parser into an AST",
      "Code generation through the OCaml LLVM bindings",
    ],
    links: [{ label: "git", href: `${git}/bocaml.git/` }],
  },
  {
    name: "website",
    lang: "astro",
    status: "active",
    when: "2026",
    desc: "This site. The black hole on the homepage is ray traced in a WebGL shader and drawn as ASCII. It's hosted on a Raspberry Pi.",
    highlights: [
      "git push builds and deploys it on the Pi",
      "Served through a Cloudflare tunnel, no open ports",
    ],
    links: [{ label: "git", href: `${git}/website.git/` }],
  },
];
---

<Base title="projects · cacheleon">
  <h1>projects</h1>

  <p class="lead">Things I've built, or am still building.</p>

  <div class="projects">
    {projects.map((p, i) => (
      <article class="fade-in" style={`--i: ${i}`}>
        <div class="bar">
          <span class="path">
            ~/projects/<strong>{p.name}</strong>
          </span>
          <span class:list={["status", p.status]}>{p.status}</span>
        </div>

        <div class="body">
          <div class="meta">
            <span class="lang">{p.lang}</span>
            <span>{p.when}</span>
          </div>

          <p class="desc">{p.desc}</p>

          {p.metrics && (
            <div class="metrics">
              {p.metrics.map((m) => (
                <div>
                  <span class="value">{m.value}</span>
                  <span class="label">{m.label}</span>
                </div>
              ))}
            </div>
          )}

          <ul class="highlights">
            {p.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>

          <div class="links">
            {p.links.map((l) => (
              <a href={l.href}>{l.label}</a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</Base>

<style>
  .lead {
    margin: 1.5rem 0 2.5rem;
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  article {
    position: relative;
    border: 1px solid var(--border);
    background: var(--panel);
    transition: border-color 0.2s;
  }

  article:hover {
    border-color: #44403c;
  }

  article::before,
  article::after {
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--purple);
    transition:
      width 0.25s,
      height 0.25s;
    pointer-events: none;
  }

  article::before {
    top: -1px;
    left: -1px;
    border-width: 1px 0 0 1px;
  }

  article::after {
    right: -1px;
    bottom: -1px;
    border-width: 0 1px 1px 0;
  }

  article:hover::before,
  article:hover::after {
    width: 40px;
    height: 40px;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.85em;
  }

  .path {
    color: var(--muted);
  }

  .path strong {
    color: var(--orange-light);
  }

  .status {
    font-size: 0.85em;
    color: var(--muted);
  }

  .status::before {
    content: "● ";
  }

  .status.active::before {
    color: #86efac;
  }

  .status.wip::before {
    color: var(--orange);
  }

  .status.done::before {
    color: var(--purple);
  }

  .body {
    padding: 1rem 1.25rem 1.1rem;
  }

  .meta {
    display: flex;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.8em;
  }

  .lang {
    color: var(--purple);
  }

  .desc {
    margin: 0.5rem 0 0;
    color: var(--fg);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1rem;
    padding: 0.75rem 0;
    border-top: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border);
  }

  .metrics div {
    display: flex;
    flex-direction: column;
  }

  .metrics .value {
    color: var(--orange);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .metrics .label {
    color: var(--muted);
    font-size: 0.75em;
  }

  .highlights {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.9em;
  }

  .highlights li {
    padding-left: 2ch;
    text-indent: -2ch;
  }

  .highlights li::before {
    content: "> ";
    color: var(--purple);
  }

  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    font-size: 0.85em;
  }

  .links a::after {
    content: " →";
  }
</style>
