---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "cacheleon's corner of the internet." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">cacheleon</a>
      <nav>
        <a href="/">home</a>
        <a href="/about/">about</a>
        <a href="https://git.cacheleon.dev">git</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>© {new Date().getFullYear()} cacheleon · served from a Raspberry Pi</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --fg: #1c1917;
    --muted: #78716c;
    --accent: #0f766e;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1917;
      --fg: #f5f5f4;
      --muted: #a8a29e;
      --accent: #2dd4bf;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0 auto;
    max-width: 42rem;
    padding: 2rem 1rem;
    background: var(--bg);
    color: var(--fg);
    font: 1.05rem/1.6 system-ui, -apple-system, sans-serif;
  }
  a { color: var(--accent); }
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }
  .brand { font-weight: 700; font-size: 1.2rem; text-decoration: none; color: var(--fg); }
  nav { display: flex; gap: 1rem; }
  footer { margin-top: 4rem; color: var(--muted); font-size: 0.9rem; }
</style>
