<div class="blackhole">
  <canvas role="img" aria-label="ASCII black hole"></canvas>
</div>

<style>
  .blackhole {
    display: grid;
    place-items: center;
    height: 100vh;
    height: 100svh;
    min-height: 320px;
    overflow: hidden;
    background: #000;
  }

  canvas {
    display: block;
  }
</style>

<script>
  import { startBlackHole } from "../blackhole/blackhole";

  const canvas =
    document.querySelector<HTMLCanvasElement>(".blackhole canvas")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  try {
    if (!startBlackHole(canvas, still)) canvas.remove();
  } catch (err) {
    console.error(err);
    canvas.remove();
  }
</script>
